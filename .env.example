# ─── Fidely — configuration ────────────────────────────────────────────
# Mode démonstration : données fictives persistées localement (.data/),
# sélecteur de rôle, envois et paiements simulés.
# NE JAMAIS activer en production avec des données réelles.
DEMO_MODE=true

# Secret de signature des cookies de session (32+ caractères aléatoires).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-with-a-long-random-string-0123456789

# URL publique (utilisée pour les QR codes d'inscription imprimés).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Répertoire de persistance des données de démonstration.
DEMO_DATA_DIR=.data

# ─── Production (non requis en mode démo) ──────────────────────────────
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Apple Wallet (voir docs/WALLET.md)
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_BASE64=

# Google Wallet (voir docs/WALLET.md)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# Envois (production)
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
